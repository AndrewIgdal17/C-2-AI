# === LLM Configuration ===
# Required: API key for the vLLM / LiteLLM endpoint
LLM_API_KEY=sk-your-api-key-here

# LLM endpoint URL (OpenAI-compatible)
LLM_API_BASE=https://litemaas.rhoai.rh-aiservices-bu.com/v1

# Model name
LLM_MODEL=Qwen3.6-35B-A3B

# === Inter-Agent Auth ===
# Shared bearer token for MCP server authentication
MCP_AUTH_TOKEN=demo-token-2024

# === Observability ===
# Set to 'false' to disable OpenTelemetry tracing
OTEL_ENABLED=true

# === Grafana ===
# URL for the frontend Grafana link (use localhost for local dev)
GRAFANA_URL=http://localhost:3001
